{
  "name": "openpdf-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A local PDF workspace for macOS",
  "main": "dist-electron/main.cjs",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "npm run resources && node scripts/dev.mjs",
    "dev:web": "npm run resources && vite --host 127.0.0.1",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "tsc --noEmit && vite build && node scripts/resources.mjs out/renderer/pdfjs && npm run build:electron",
    "test": "vitest run",
    "test:desktop": "node scripts/test-desktop.mjs",
    "start": "electron .",
    "package": "npm run build && electron-builder --mac --dir",
    "resources": "node scripts/resources.mjs",
    "format": "prettier --write src electron tests scripts vite.config.ts tsconfig.json"
  },
  "build": {
    "appId": "org.openpdf.studio",
    "productName": "OpenPDF Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/renderer/**/*",
      "dist-electron/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "identity": null,
      "icon": "build/icon.png"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "role": "Editor"
      }
    ]
  },
  "dependencies": {
    "lucide-react": "1.34.0",
    "mupdf": "1.28.0",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
